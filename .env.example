PORT=5000
NODE_ENV=development

# Supabase is used by the production API over HTTPS (port 443).
SUPABASE_URL=
# Preferred modern server-only key: sb_secret_...
SUPABASE_SECRET_KEY=
# Optional legacy fallback if you still use a service_role JWT key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=ewucsc-public
SUPABASE_PRIVATE_BUCKET=ewucsc-private

# Keep MONGO_URI only while migrating old production data to Supabase locally.
MONGO_URI=

JWT_SECRET=

# Firebase project ID used to validate Firebase ID tokens.
FIREBASE_PROJECT_ID=smart-deals-37b05

# Comma-separated browser origins allowed to call the API.
CLIENT_URL=http://localhost:5173
LIVE_CLIENT_URL=
ALLOWED_ORIGINS=

# Optional additional comma-separated bootstrap Admin emails.
BOOTSTRAP_ADMIN_EMAILS=
